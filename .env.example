# ==============================================================================
# Nano-Agent & Bifrost Gateway Environment Configuration
# ==============================================================================

# 1. Cloud Provider Credentials (Placeholders for Bifrost upstream routing)
OPENAI_API_KEY=sk-proj-placeholder-openai-key-here
ANTHROPIC_API_KEY=sk-ant-placeholder-anthropic-key-here

# 2. Local Ollama Gateway Configuration
OLLAMA_BASE_URL=http://localhost:11434

# 3. Bifrost Security & Virtual Key
# 32-character encryption key used by Bifrost for securing internal state
BIFROST_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
# Virtual Key configured in bifrost/config.json (passed as Bearer token by clients)
BIFROST_VIRTUAL_KEY=sk-bf-nano-agent-secret-key

# 4. Agent Gateway Connection Settings
BIFROST_BASE_URL=http://localhost:8080/v1
BIFROST_API_KEY=sk-bf-nano-agent-secret-key
AGENT_USER_ID=hackathon-dev-1

# 5. Agent Guardrails
AGENT_BUDGET_CAP=1.00
PRIVACY_MODE=false
